{
  "name": "claimpack",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Turns a PayPal dispute into a complete, rule-checked evidence pack; a person approves, then it is filed through the PayPal Disputes API.",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "server": "tsx server/index.ts",
    "web:dev": "vite --config web/vite.config.ts",
    "web:build": "vite build --config web/vite.config.ts",
    "app": "npm run web:build && tsx server/index.ts",
    "typecheck:web": "tsc --noEmit -p web/tsconfig.json"
  },
  "engines": {
    "node": ">=22.5"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "hono": "^4.13.16",
    "openai": "^7.51.0",
    "pdf-lib": "^1.17.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/public-sans": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "ag-grid-community": "^36.3.0",
    "ag-grid-react": "^36.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
