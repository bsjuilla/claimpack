# Copy this file to .env and fill in the values. .env is git-ignored; never commit it.

# PayPal sandbox app: developer.paypal.com > Apps & Credentials > Sandbox > your app (e.g. "Default Application")
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
# Optional: only if PayPal can reach this computer (a public URL). Without it, ClaimPack checks PayPal itself.
PAYPAL_WEBHOOK_ID=
# How often ClaimPack checks PayPal for new or changed disputes (seconds; 0 turns it off)
CLAIMPACK_POLL_SECONDS=45

# AI: Meta Model API (OpenAI-compatible). Get a key at dev.meta.ai.
META_API_KEY=
META_API_BASE_URL=https://api.meta.ai/v1
META_MODEL_EXTRACT=muse-spark-1.3
