# Copy this file to .env and fill in the values. .env is git-ignored; never commit it.
# PayPal sandbox app: developer.paypal.com > Apps & Credentials > Sandbox > Default Application
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
# Webhook id from developer.paypal.com > your app > Webhooks (added later)
PAYPAL_WEBHOOK_ID=
# AI model key (Meta Model API or other) added later
AI_API_KEY=
